{
  "name": "connect-pharma",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node server/index.mjs",
    "dev:preview": "node -e \"process.env.LOCAL_ROLE_PREVIEW='true'; import('./server/index.mjs')\"",
    "build": "node --check server/index.mjs && node --check public/assets/app.js",
    "start": "node server/index.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:e2e",
    "test:unit": "node --test server/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "node scripts/verify-e2e.mjs",
    "db:seed-plans": "node scripts/seed-plans.mjs",
    "db:seed-medicines": "node scripts/seed-medicines.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "express": "^5.3.0",
    "postgres": "^3.4.7",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^14.0.0",
    "typescript": "^5.7.2"
  }
}
