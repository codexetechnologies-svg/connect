# PostgreSQL connection string for Supabase or Neon. URL-encode special characters in credentials.
DATABASE_URL=
# Optional alternative if your host names the connection string separately.
NEON_DATABASE_URL=
# Supabase Auth project used by the Express HTML app.
SUPABASE_URL=
# Configure the anon key or publishable key. Never use the service-role key in browser code.
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Server-only; required to remove linked Supabase Auth users during account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Unique signing key for application sessions; generate at least 32 random bytes.
SESSION_SECRET=
RESEND_API_KEY=
EMAIL_FROM="The Connect Pharma <noreply@connectpharma.in>"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to the trusted reverse-proxy hop count when deployed behind a proxy.
TRUST_PROXY_HOPS=
# Local-only auth seed settings. Never add these to production configuration.
AUTH_SEED_ADMIN_EMAIL=
AUTH_SEED_MEDICAL_SHOP_EMAIL=
AUTH_SEED_SUPPLIER_EMAIL=
AUTH_SEED_CONFIRM=
# Optional localhost-only, read-only portal preview. Never enable in production.
LOCAL_ROLE_PREVIEW=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Private bucket for server-streamed uploads; do not enable public access.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Cashfree webhook signing uses the PG secret; leave blank to reuse CASHFREE_SECRET_KEY.
CASHFREE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://localhost:4000
